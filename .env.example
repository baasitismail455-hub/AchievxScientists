# Copy this file to .env and change the secret key.
SECRET_KEY=replace-this-with-a-long-random-secret
# Local development uses SQLite automatically when DATABASE_URL is blank.
# For PostgreSQL, uncomment and set your own local/server database credentials:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/achievx_scientist

SITE_NAME=AchievX Scientist
MAX_CONTENT_LENGTH_MB=100
